nes":[{"de":"Bergung · Tag · Wind","en":"Rescue · Day · Wind","fr":"Sauvetage · Jour · Vent","es":"Rescate · Día · Viento","pt":"Resgate · Dia · Vento"}],"briefing":{"de":"Die Flut geht zurück. Fünf Personen und ein Crewman noch am Boden die zum Carrier müssen — drei Kisten vom Carrier ans Helipad an Land. Der Verband kehrt zurück. Das hier ist der letzte Flug.","en":"The flood is receding. Five survivors still on the ground — three crates from the carrier to the land pad. The task force is standing down. This is the last flight.","fr":"La crue se retire. Cinq survivants toujours au sol — trois caisses du porte-avions vers le pad à terre. Le groupe opérationnel se retire. C'est le dernier vol.","es":"La inundación retrocede. Cinco supervivientes aún en tierra — tres cajas del portaaviones al pad en tierra. El grupo de intervención se retira. Este es el último vuelo.","pt":"A inundação está recuando. Cinco sobreviventes ainda em terra — três caixas do porta-aviões para o pad em terra. A força-tarefa está se retirando. Este é o último voo."},"waterLevel":0,"spawnObject":"pad","objects":[{"type":"pad","x":239,"y":200},{"type":"carrier","x":127,"y":228,"angle":310,"path":"straight","speed":6,"radius":40,"coordinatorHeli":true,"vesselName":"","exitWarning":true}],"payloads":[{"type":"person","x":247,"y":267,"deliverTo":"carrier"},{"type":"person","x":223,"y":275,"deliverTo":"carrier"},{"type":"person","x":242,"y":264,"deliverTo":"carrier"},{"type":"person","x":234,"y":248,"deliverTo":"carrier"},{"type":"person","x":260,"y":264,"deliverTo":"carrier"},{"type":"crate","x":122,"y":229,"attachTo":{"objectType":"carrier","objectIdx":1},"deliverTo":"pad"},{"type":"crate","x":123,"y":233,"attachTo":{"objectType":"carrier","objectIdx":1},"deliverTo":"pad"},{"type":"crate","x":125,"y":232,"attachTo":{"objectType":"carrier","objectIdx":1},"deliverTo":"pad"},{"type":"rescuer","x":247,"y":207,"deliverTo":"carrier"}],"objectives":[{"type":"rescue_all"},{"type":"land_at","target":"carrier"}],"rain":false,"night":false,"windDir":135,"windStr":2,"windVar":false,"music":"carrierops","terrainRef":3}]}