ento."},"gridSize":300,"terrain":"-10x90601","spawnObject":"carrier","objects":[{"type":"carrier","x":80,"y":156,"angle":19,"path":"straight","speed":6,"radius":40,"vesselName":"","exitWarning":true},{"type":"submarine","x":168,"y":227,"angle":195,"path":"circle","speed":4,"radius":330,"vesselName":"","exitWarning":true}],"payloads":[{"type":"rescuer","x":172,"y":227,"attachTo":{"objectType":"submarine","objectIdx":1},"deliverTo":"carrier"},{"type":"rescuer","x":171,"y":228,"attachTo":{"objectType":"submarine","objectIdx":1},"deliverTo":"carrier"},{"type":"crate","x":81,"y":158,"attachTo":{"objectType":"carrier","objectIdx":0},"deliverTo":"submarine"},{"type":"crate","x":78,"y":155,"attachTo":{"objectType":"carrier","objectIdx":0},"deliverTo":"submarine"},{"type":"rescuer","x":169,"y":227,"attachTo":{"objectType":"submarine","objectIdx":1},"deliverTo":"carrier"}],"foliage":"","objectives":[{"type":"rescue_all"},{"type":"land_at","target":"carrier"}],"rain":true,"night":true,"windDir":315,"windStr":3,"windVar":true,"waterLevel":0,"music":"offshore"},{"headline":{"de":"Überflutetes Atoll","en":"Flooded Atoll","fr":"Atoll inondé","es":"Atolón inundado","pt":"Atol inundado"},"sublines":[{"de":"Bergung · Tag · Regen · Hochflut","en":"Rescue · Day · Rain · High Water","fr":"Sauvetage · Jour · Pluie · Crue","es":"Rescate · Día · Lluvia · Inundación","pt":"Resgate · Dia · Chuva · Cheia"}],"briefing":{"de":"Wir sind vor Ort. Der Sturm hat das Atoll fast vollständig verschluckt. Acht Überlebende auf winzigen Landzungen, vier Versorgungskisten. Start vom Carrier. Keiner bleibt zurück.","en":"We are on site. The storm took almost everything. Eight survivors on scraps of land, four supply crates. Launch from the carrier. Everyone comes home.","fr":"Nous sommes sur place. La tempête a englouti presque tout l'atoll. Huit survivants sur des lambeaux de terre, quatre caisses de ravitaillement. Départ depuis le porte-avions. Personne n'est laissé derrière.","es":"Estamos en el lugar. La tormenta se ha llevado casi todo. Ocho supervivientes en retazos de tierra, cuatro cajas de suministros. Despegue desde el portaaviones. Nadie se queda atrás.","pt":"Estamos no local. A tempestade engoliu quase tudo. Oito sobreviventes em fragmentos de terra, quatro caixas de suprimentos. Decolagem do porta-aviões. Ninguém fica para trás."},"gridSize":500,"terrain":"-10x84416,-8,-7x2,-8,-10x495,-9,-5,0,2,1,-2,-6,-9,-10x492,-9,-2,7,13,16,14,8,0,-7,-10x491,-9,2,13,23,30,31,28,18,7,-4,-9,-10x2,-9,-10x486,-8,4,18,31,41,46x2,38,25,11,-2,-8,-9,-8x3,-9x2,-10x482,-9,5,21,38,50,57,61,54,41,26,11,-2,-8x2,-7,-6x3,-7,-8,-9,-10x3,-9,-7,-5,-6,-8,-10x472,4,22,41,56,66,71,68,55,39,23,7,-5,-8,-7,-5,-4,-3,-4,-5,-6,-8,-9x2,-7,-2,4,8,7,4,-2,-8,-10x468,-7,5,21,40,58,71,77,76,66,51,33,15,0,-8x2,-6,-5,-3,-2x2,-3,-5,-6,-7x2,-1,9,18,23x2,19,12,3,-6,-9,-10x464,-6,0,8,22,38,56,71,79,80,75,60,42,22,4,-8,-10,-8,-7,-5,-3,-2x2,-3,-4,-5,-6,-2,7,20,31,37,38,35,27,17,6,-3,-8,-10x461,-3,2,8,15,25,38,52,67,76,79,77,65,48,28,9,-6,-10x2,-9,-8,-6,-5,-4,-3,-4,-5x2,-4,1,11,25,38,47,51,49,42,32,20,11,3,-4,-9,-10x457,-3,4,12,20,27,34,42,52,62,70,74x2,64,50,32,13,-2,-10x4,-9,-8,-7,-6x4,-5,-4,1,11,25,38,48,53x2,49,43,34,26,18,10,4,-1,-8,-10x452,-9,-3,3,12,23,33,41,46,50,56,61,65,67x2,59,48,32,15,-1,-10x7,-9x2,-8x3,-7,-5,-1,7,19,31,40,47,50x2,46,43,40,33,27,21,14,7,1,-6,-9,-10x445,-9,-8,-6,0,5,12,21,33,44,53,59,61,63x3,62,60,53,43,29,14,0,-10x11,-9x2,-8,-6,-4,1,8,18,26,32,38,42,45,46,47,46,42,38,32,25,17,9,2,-5,-10x442,-7,-4,0,4,9,15,22,31,41,51,60,68,72,71,67,63,59,54,48,38,27,13,-2,-10x15,-8,-6,-5,-2,4,10,17,23,29,37,43,49,52,54,53,47,42,35,27,18,8,0,-9,-10x438,-9,-4,3,10,15,20,25,32,40,48,56,65,71,73x2,70,63,55,47,40,33,23,12,-1,-8,-10x16,-9,-8,-7,-6,-4,2,8,15,23,33,43,51,56,58x2,56,50,43,35,25,14,4,-5,-10x437,-5,4,15,24,30,35,40,47,54,60,65,68,70x2,64,57,49,40,32,25,18,11,4,-3,-8,-10x18,-9x2,-8x2,-6,0,9,19,30,41,49,56,58,60,59,57,50,42,31,20,10,2,-4,-10x434,-8,-1,11,24,34,41,47,50,53,57,60,63,62,59,55,4