// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`heli-select > snapshot 1`] = `
"
        <div class="title">HANGAR</div>
        <div class="subtitle">SELECT AIRCRAFT</div>
        <div class="screen-body"><div class="swipe-carousel"><div class="swipe-track"><div class="swipe-card" data-index="0">
                <canvas id="icon-dolphin" class="heli-card-canvas"></canvas>
                <div class="heli-card-label">
                    <div class="box-label">DOLPHIN</div>
                    <div class="box-sub heli-cap-label heli-card-label-sub">Kap.: 3 (Leichtgewicht)</div>
                </div></div><div class="swipe-card" data-index="1">
                <canvas id="icon-coasthawk" class="heli-card-canvas"></canvas>
                <div class="heli-card-label">
                    <div class="box-label">Coast-Hawk</div>
                    <div class="box-sub heli-cap-label heli-card-label-sub">Kap.: 10 (Schwerlast)</div>
                </div></div><div class="swipe-card" data-index="2">
                <canvas id="icon-atlas" class="heli-card-canvas"></canvas>
                <div class="heli-card-label">
                    <div class="box-label">Atlas</div>
                    <div class="box-sub heli-cap-label heli-card-label-sub">Kap.: 20 (Schwerlast)</div>
                </div></div><div class="swipe-card" data-index="3">
                <canvas id="icon-ornithopter" class="heli-card-canvas"></canvas>
                <div class="heli-card-label">
                    <div class="box-label">ORNITHOPTER</div>
                    <div class="box-sub heli-cap-label heli-card-label-sub">Kap.: 2 (Schnelleinsatz)</div>
                </div></div></div><div class="swipe-right-overlay"></div></div></div><div class="back-btn">◀ BACK</div>"
`;

exports[`legal-screen > snapshot 1`] = `
"
        <div class="title">LEGAL NOTICE</div>
        
        <div class="screen-body"><div class="legal-content"><div class="legal-section-heading">IMPRINT</div><div class="legal-para">Information according to § 5 TMG / DDG:</div><div class="legal-spacer"></div><div class="legal-para">Michael Draws-Beer</div><div class="legal-para">Friedrichstrasse 46</div><div class="legal-para">53332</div><div class="legal-para">Germany</div><div class="legal-spacer"></div><div class="legal-para">Contact</div><div class="legal-para">Email: yarrick@web.de</div><div class="legal-spacer"></div><div class="legal-para">Responsible for content (§ 18 para. 2 MStV):</div><div class="legal-para">Michael Draws-Beer – address as above</div><div class="legal-section-heading">PRIVACY POLICY</div><div class="legal-para">SAR: Callsign WOLF stores the following data exclusively locally on your device – and only with your consent:</div><div class="legal-para">▸ Callsign  ▸ Rank  ▸ Campaign progress  ▸ Consent status  ▸ Language setting</div><div class="legal-para">Legal basis: Art. 6 para. 1 lit. a GDPR (consent). Stored data can be deleted at any time via Main Menu → Settings → Delete Save.</div><div class="legal-para">The control setting is always stored locally regardless of consent (purely technical device setting, no personal data).</div><div class="legal-para">No data is shared with third parties.</div><div class="legal-para">Privacy contact: yarrick@web.de</div><div class="legal-para">When establishing a multiplayer connection, Google STUN servers (stun.l.google.com) are contacted to broker the peer-to-peer connection. Your IP address is transmitted – solely at your initiative and only for the duration of the connection setup. Legal basis: Art. 6 para. 1 lit. b GDPR.</div></div></div><div class="back-btn">◀ BACK</div>"
`;

exports[`mission-select > showMissionSelect renders mission cards 1`] = `
"
        <div class="title">Test Kampagne</div>
        <div class="subtitle">MISSIONS</div>
        <div class="screen-body"><div class="swipe-carousel"><div class="swipe-track"><div class="swipe-card" data-index="0"><div class="box-label">Mission 1</div><div class="box-sub">Sublevel 1</div></div><div class="swipe-card locked" data-index="1"><div class="box-label">Mission 2</div><div class="box-sub" style="color:#333">[ LOCKED ]</div></div><div class="swipe-card locked" data-index="2"><div class="box-label">Mission 3</div><div class="box-sub" style="color:#333">[ LOCKED ]</div></div></div><div class="swipe-right-overlay"></div></div></div><div class="back-btn">◀ BACK</div>"
`;

exports[`pause-overlay > snapshot of pause button 1`] = `
"
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">
            <defs><filter id="glow-gear"><feGaussianBlur stdDeviation="1.5" result="blur"></feGaussianBlur>
                <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter></defs>
            <g filter="url(#glow-gear)" fill="#ff6600" stroke="#ff8800" stroke-width="0.5">
                <path d="M12.8 7.1 L13.7 2.7 L18.3 2.7 L19.2 7.1 L22.1 8.7 L26.3 7.3 L28.7 11.4 L25.4 14.4 L25.4 17.6 L28.7 20.6 L26.3 24.7 L22.1 23.3 L19.2 24.9 L18.3 29.3 L13.7 29.3 L12.8 24.9 L9.9 23.3 L5.7 24.7 L3.3 20.6 L6.6 17.6 L6.6 14.4 L3.3 11.4 L5.7 7.3 L9.9 8.7 Z" fill="none" stroke="#ff6600" stroke-width="1.8" stroke-linejoin="round"></path>
            </g>
        </svg>"
`;

exports[`touch-controls > snapshot 1`] = `
"
        <div id="touch-pad-left">
            <div id="touch-top-row">
                <div id="touch-pitch-wheel" title="Winschen">
                    <div id="touch-pitch-drum"></div>
                    <div id="touch-pitch-indicator"></div>
                    <span class="pitch-label pitch-up">↑</span>
                    <span class="pitch-label pitch-dn">↓</span>
                </div>
                <div id="touch-deliver-toggle" class="touch-btn" data-key="KeyR" title="Absetz-Modus">
                    <div class="toggle-housing">
                        <div class="toggle-rocker"></div>
                    </div>
                </div>
            </div>
            <div class="joystick" id="joystick-left">
                <span class="js-n">W</span><span class="js-s">S</span>
                <span class="js-w">A</span><span class="js-e">D</span>
                <div class="joystick-knob"></div>
            </div>
        </div>
        <div class="joystick" id="joystick-right">
            <div class="js-safe-zone"></div>
            <span class="js-n">▲</span><span class="js-s">▼</span>
            <span class="js-w">◀</span><span class="js-e">▶</span>
            <div class="joystick-knob"></div>
        </div>"
`;
