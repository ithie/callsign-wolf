// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`UI screen snapshots > briefing 1`] = `""`;

exports[`UI screen snapshots > cookie-banner 1`] = `
"<div id="cookie-inner">
        <div class="cookie-lang-row">
            <button class="cookie-lang-btn" data-lang="de">DEUTSCH</button>
            <button class="cookie-lang-btn active" data-lang="en">ENGLISH</button>
        </div>
        <div style="color:#cc9900;font-size:15px;letter-spacing:5px;font-weight:bold">PRIVACY</div>
        <p>SAR: Callsign WOLF can store the following data <strong style="color:#aaa">exclusively local</strong> in your browser (localStorage) – but only with your consent:</p>
        <p style="color:#555;font-size:13px;line-height:1.6">▸ Callsign &nbsp;▸ Rank &nbsp;▸ Campaign progress &nbsp;▸ Consent status &nbsp;▸ Language setting</p>
        <p><strong style="color:#aaa">Accept:</strong> Data is stored locally – your progress is saved permanently. <strong style="color:#aaa">Decline:</strong> No data is stored – the game is fully playable, but without persistent progress.</p>
        <p>Independently, the control setting is <strong style="color:#aaa">always stored locally</strong>, as it is a purely technical device setting (no personal data).</p>
        <p style="border-top:1px solid #1a2a1a;padding-top:10px;margin-top:4px">
            <strong style="color:#cc9900">MULTIPLAYER MODE:</strong>
            When you establish a multiplayer connection, <strong style="color:#aaa">Google STUN servers</strong> (stun.l.google.com) are contacted to broker the direct peer-to-peer connection. Your <strong style="color:#aaa">IP address</strong> is transmitted to Google solely at your active initiative and only for the duration of the connection setup. Google does <strong style="color:#aaa">not set any cookies</strong>. Legal basis: Art.&nbsp;6 para.&nbsp;1 lit.&nbsp;b GDPR.
        </p>
        <p style="color:#444;font-size:12px">Legal basis for local storage: Art.&nbsp;6 para.&nbsp;1 lit.&nbsp;a GDPR (consent). Stored data can be deleted at any time via <strong style="color:#555">Main Menu → Settings → Delete Save</strong>.</p>
        <div id="cookie-buttons">
            <button class="approve" onclick="approveCookies()">ACCEPT</button>
            <button class="decline" onclick="declineCookies()">DECLINE</button>
            
        </div>
    </div>"
`;

exports[`UI screen snapshots > credits-screen 1`] = `
"
        <div class="title">CREDITS</div>
        
        <div class="screen-body"><canvas id="credits-canvas"></canvas><div id="credits-inner"></div></div><div class="back-btn">◀ BACK</div>"
`;

exports[`UI screen snapshots > main-menu 1`] = `
"<canvas id="main-menu-bg-canvas"></canvas>
        <div class="title">SAR: CALLSIGN WOLF</div>
        <div class="subtitle">MAIN SYSTEM</div>
        <div class="screen-body">
        <nav class="menu-nav">
            <div class="menu-item" id="menu-item-start">START GAME</div>
            <div class="menu-item" id="menu-item-multiplayer">MULTIPLAYER</div>
            <div class="menu-item" id="menu-item-settings">SETTINGS</div>
            <div class="menu-item" id="menu-item-credits">CREDITS</div>
        </nav></div>"
`;

exports[`UI screen snapshots > mp-lobby-screen 1`] = `
"
        <div class="title">MULTIPLAYER</div>
        <div class="subtitle" style="margin-bottom:8px">CO-OP MISSION</div>

        <div id="mp-lobby-initial">
            <button class="mp-btn" id="mp-create-btn">CREATE GAME</button>
            <button class="mp-btn" id="mp-join-btn">JOIN</button>
        <div class="back-btn">◀ BACK</div></div>

        <!-- Host flow -->
        <div id="mp-host-flow" class="mp-flow" style="display:none">
            <div class="mp-status" id="mp-host-status">GENERATING...</div>
            <div class="mp-label">Step 1: Send this code to your co-pilot:</div>
            <textarea id="mp-offer-txt" class="mp-textarea" readonly=""></textarea>
            <div class="mp-row">
                <button class="mp-btn mp-btn-small" id="mp-copy-offer-btn">COPY</button>
            </div>
            <div class="mp-label">Step 2: Paste your co-pilot's answer:</div>
            <textarea id="mp-answer-input" class="mp-textarea" placeholder="Paste code here…"></textarea>
            <button class="mp-btn" id="mp-connect-btn" disabled="">CONNECT</button>
        <div class="back-btn">◀ BACK</div></div>

        <!-- Guest flow -->
        <div id="mp-guest-flow" class="mp-flow" style="display:none">
            <div class="mp-label">Paste the host's code:</div>
            <textarea id="mp-offer-input" class="mp-textarea" placeholder="Paste code here…"></textarea>
            <button class="mp-btn" id="mp-gen-answer-btn">GENERATE ANSWER</button>
            <div class="mp-status" id="mp-guest-status"></div>
            <div class="mp-label" id="mp-guest-step2-label" style="display:none">Send this code to the host:</div>
            <textarea id="mp-answer-txt" class="mp-textarea" readonly="" style="display:none"></textarea>
            <div class="mp-row" id="mp-guest-copy-row" style="display:none">
                <button class="mp-btn mp-btn-small" id="mp-copy-answer-btn">COPY</button>
            </div>
        <div class="back-btn">◀ BACK</div></div>

        <!-- Heli select + ready phase (shared by host and guest) -->
        <div id="mp-heli-flow" class="mp-flow" style="display:none">
            <div class="mp-status ok" id="mp-ready-peer-label"></div>
            <div class="mp-label">SELECT AIRCRAFT</div>
            <div class="mp-heli-cards" id="mp-heli-cards">
            <div class="mp-heli-card" data-id="dolphin">
                <div class="mp-heli-card-label">DOLPHIN</div>
                <div class="mp-heli-card-sub">Wendig / Schnell</div>
            </div>
            <div class="mp-heli-card" data-id="coasthawk">
                <div class="mp-heli-card-label">Coast-Hawk</div>
                <div class="mp-heli-card-sub">Schwer / Stabil</div>
            </div>
            <div class="mp-heli-card" data-id="atlas">
                <div class="mp-heli-card-label">Atlas</div>
                <div class="mp-heli-card-sub">Tandem / Extraschwer</div>
            </div>
            <div class="mp-heli-card" data-id="ornithopter">
                <div class="mp-heli-card-label">ORNITHOPTER</div>
                <div class="mp-heli-card-sub">Schläger / Wendig</div>
            </div></div>
            <div class="mp-status" id="mp-ready-status">READY FOR DEPLOYMENT?</div>
            <button class="mp-btn" id="mp-ready-btn" disabled="">READY</button>
            <div id="mp-countdown-display" class="mp-countdown" style="display:none"></div>
        </div>"
`;

exports[`UI screen snapshots > mute-button 1`] = `
"
<svg xmlns="http://www.w3.org/2000/svg" id="audio-mute-inactive" viewBox="0 0 32 32" width="32" height="32">
  <defs><filter id="glow"><feGaussianBlur stdDeviation="1.5" result="blur"></feGaussianBlur>
    <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
  </filter></defs>
  <g filter="url(#glow)">
    <polygon points="4,11 4,21 9,21 16,27 16,5 9,11" fill="#ff6600" stroke="#ff8800" stroke-width="0.5"></polygon>
    <path d="M19,11 Q23,16 19,21" fill="none" stroke="#ff6600" stroke-width="2" stroke-linecap="round"></path>
    <path d="M22,8 Q28,16 22,24" fill="none" stroke="#ff6600" stroke-width="2" stroke-linecap="round" opacity="0.7"></path>
  </g>
</svg>
<svg xmlns="http://www.w3.org/2000/svg" id="audio-mute-active" viewBox="0 0 32 32" width="32" height="32">
  <defs>
    <filter id="glow-red"><feGaussianBlur stdDeviation="1.5" result="blur"></feGaussianBlur>
      <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
    </filter>
    <filter id="glow-grey"><feGaussianBlur stdDeviation="0.8" result="blur"></feGaussianBlur>
      <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
    </filter>
  </defs>
  <polygon points="4,11 4,21 9,21 16,27 16,5 9,11" fill="#444" stroke="#555" stroke-width="0.5" filter="url(#glow-grey)"></polygon>
  <g filter="url(#glow-red)">
    <line x1="20" y1="11" x2="28" y2="21" stroke="#ff2200" stroke-width="2.5" stroke-linecap="round"></line>
    <line x1="28" y1="11" x2="20" y2="21" stroke="#ff2200" stroke-width="2.5" stroke-linecap="round"></line>
  </g>
</svg>"
`;

exports[`UI screen snapshots > rankup-overlay 1`] = `
"
        <div id="rankup-label">Promotion</div>
        <div id="rankup-badge"></div>
        <div id="rankup-title"></div>
        <div id="rankup-address"></div>
        <div id="rankup-heli" style="display:none">
            <div class="rankup-heli-label">NEW AIRCRAFT UNLOCKED</div>
            <div class="rankup-heli-name"></div>
        </div>
        <p class="start-hint" style="color: #cc9900; margin-top: 10px">Continue</p>"
`;

exports[`UI screen snapshots > settings-screen 1`] = `
"
        <div class="title">SETTINGS</div>
        <div class="subtitle">PROFILE</div>
        <div class="screen-body">
        <div id="settings-badge"></div>
        <div class="settings-field">
            <label>CALLSIGN (MAX. 8 CHARS, A–Z)</label>
            <input id="player-name-input" type="text" maxlength="5" placeholder="—">
        </div>
        <div id="settings-stats"></div>
        <div class="settings-field" style="margin-top: 8px">
            <label>SAVE CODE</label>
            <div id="settings-code-display">—</div>
        </div>
        <div class="settings-field">
            <label>IMPORT CODE (OVERWRITES SAVE)</label>
            <div style="display:flex; gap: 10px; align-items: center">
                <input id="import-code-input" class="settings-field input" type="text" maxlength="10" placeholder="XXXXX-XXXX">
                <button class="settings-btn" id="apply-save-code-btn">LOAD</button>
            </div>
            <div id="import-code-msg" style="font-size: 12px; letter-spacing: 2px; min-height: 18px; margin-top: 4px"></div>
        </div>
        <div id="settings-ctrl-row" style="display:none; flex-direction:column; align-items:center; margin-top:16px; width:100%">
            <div class="settings-field" style="width:100%">
                <label>CONTROLS</label>
                <div style="display:flex; gap:10px; margin-top:6px">
                    <button class="settings-btn" id="ctrl-btn-profi">SIMPLIFIED</button>
                    <button class="settings-btn" id="ctrl-btn-vereinfacht">PROFESSIONAL</button>
                </div>
                <div id="ctrl-mode-hint" style="font-size:11px; letter-spacing:1px; color:#8af; margin-top:4px; min-height:16px"></div>
            </div>
        </div>
        <div style="margin-top: 20px; border-top: 1px solid #1a1a2e; padding-top: 16px; width: 100%; display: flex; flex-direction: column; align-items: center; gap: 10px">
            <div class="settings-field" style="width:100%">
                <label>MUSIC</label>
                <div style="display:flex; gap:10px; margin-top:6px">
                    <button class="settings-btn" id="music-on-btn">ON</button>
                    <button class="settings-btn" id="music-off-btn">OFF</button>
                </div>
            </div>
            <div class="settings-field" style="width:100%">
                <label>SOUND EFFECTS</label>
                <div style="display:flex; gap:10px; margin-top:6px">
                    <button class="settings-btn" id="sfx-on-btn">ON</button>
                    <button class="settings-btn" id="sfx-off-btn">OFF</button>
                </div>
            </div>
            <div class="settings-field" style="width:100%">
                <label>LANGUAGE</label>
                <div style="display:flex; gap:10px; margin-top:6px">
                    <button class="settings-btn" id="lang-de-btn">DEUTSCH</button>
                    <button class="settings-btn" id="lang-en-btn">ENGLISH</button>
                </div>
            </div>
        </div>
        <div style="margin-top: 20px; border-top: 1px solid #1a1a2e; padding-top: 16px; width: 100%; display: flex; flex-direction: column; align-items: center">
            <button id="delete-session-btn" class="settings-btn" style="background: #1a0000; border-color: #500; color: #c44">DELETE SAVE</button>
            <div id="delete-session-msg" style="font-size: 12px; letter-spacing: 2px; color: #c44; min-height: 18px; margin-top: 6px"></div>
        </div>
        </div><div class="back-btn">◀ BACK</div>"
`;

exports[`UI screen snapshots > whats-new 1`] = `
"
        <div id="whats-new-version">WHAT'S NEW · v26.4.0</div>
        <div id="whats-new-title">IOS APP</div>
        <ul id="whats-new-items">
            <li>Now available as a native iOS app</li>
        </ul>
        <div id="whats-new-hint">CLICK TO CONTINUE</div>"
`;
